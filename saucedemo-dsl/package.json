{
  "name": "saucedemo-dsl",
  "version": "1.0.0",
  "private": true,
  "description": "A small model-based testing DSL for SauceDemo, implemented with TypeScript and Playwright.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  }
}
